# Copy to .env (or export in your shell) if you want non-interactive login
# instead of running `garmin-mcp-auth` interactively.

# Garmin Connect email + password. Only needed for the initial login or if
# the cached token expires and you want the server to re-auth on its own
# (MFA accounts should use `garmin-mcp-auth` instead, since MFA needs a
# one-time interactive code).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where session tokens are cached after login. Defaults to ~/.garminconnect
# if unset — you normally don't need to set this.
GARMIN_TOKENS=

# Preferred: Garmin's official Personal API. Create a key at
# https://connect.garmin.com/app/settings/personalApiToken (expires in 30d /
# 90d / 180d / 1y — Garmin emails a reminder a week before). When set, no
# password or MFA is needed. Read-only.
GARMIN_PERSONAL_API_KEY=

# IANA timezone used for "today" (default Europe/Oslo).
GARMIN_TZ=

# Hosted (Docker/Render) only: long random string used as the secret URL path
# (served at /<MCP_PATH>/mcp). Never commit it.
MCP_PATH=
